{
  "name": "gemini-tray",
  "private": true,
  "version": "2.0.0",
  "description": "Google Gemini in the Windows system tray with local voice input and Screenshot & Ask",
  "author": "SphaeroX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SphaeroX/GeminiTray.git"
  },
  "type": "module",
  "scripts": {
    "dev": "npm run build:bridge && vite",
    "build": "npm run build:bridge && vue-tsc --noEmit && vite build",
    "build:bridge": "vite build --config vite.bridge.config.ts",
    "tauri": "tauri",
    "test": "npm run test:ui && npm run test:rust",
    "test:ui": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "typecheck": "vue-tsc --noEmit",
    "version:check": "node scripts/version-check.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "vue": "^3.5.13",
    "vue-i18n": "^11.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.5"
  }
}
