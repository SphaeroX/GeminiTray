{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "App-owned local windows (settings, indicator, prompt menu, overlay, toast). The Gemini window has no capabilities.",
  "windows": [
    "settings",
    "indicator",
    "prompts",
    "overlay-*",
    "toast"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-hide"
  ]
}
